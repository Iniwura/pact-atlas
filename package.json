{
  "name": "pact-atlas",
  "private": true,
  "version": "0.1.0",
  "description": "Dependency-aware NEAR community funding with verifiable onchain allocation",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:sandbox": "node scripts/sandbox-verification.js",
    "test:counterfactual": "node --test web/tests/counterfactual.test.mjs web/tests/funding-view.test.mjs web/tests/campaign-solver.test.mjs",
    "test:benchmark": "node --test tests/competitive-benchmark.test.js",
    "benchmark": "node scripts/competitive-benchmark.js --write evidence/competitive-benchmark.json",
    "test:workflow": "node --test web/tests/near-workflow.test.mjs",
    "test:chain": "node --test web/tests/campaign-chain.test.mjs web/tests/near-rpc.test.mjs web/tests/campaign-live-data.test.mjs web/tests/contract-interface.test.mjs",
    "test:proof": "node --test web/tests/testnet-proof.test.mjs",
    "test:wallet-adapter": "node --test web/tests/near-adapter.test.mjs",
    "test:wallet-selector": "node --test web/tests/wallet-selector-host.test.mjs",
    "test:browser": "playwright test -c web/playwright.config.mjs",
    "preview": "node web/server.mjs",
    "verify": "bash scripts/verify-rust.sh",
    "verify:campaign": "node scripts/verify-campaign.js",
    "verify:testnet": "node scripts/verify-testnet.mjs"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "axe-core": "^4.11.0",
    "near-sandbox-modern": "npm:near-sandbox@0.3.4",
    "near-workspaces": "5.0.0"
  }
}
