{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/console",
      "destination": "/console.html"
    },
    {
      "source": "/campaign",
      "destination": "/campaign.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
