{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/styles.css",
      "destination": "/web/styles.css"
    },
    {
      "source": "/styles-lurais.css",
      "destination": "/web/styles-lurais.css"
    },
    {
      "source": "/app.js",
      "destination": "/web/app.js"
    },
    {
      "source": "/engine.mjs",
      "destination": "/web/engine.mjs"
    },
    {
      "source": "/near-workflow.mjs",
      "destination": "/web/near-workflow.mjs"
    },
    {
      "source": "/near-adapter.mjs",
      "destination": "/web/near-adapter.mjs"
    },
    {
      "source": "/data/evidence.json",
      "destination": "/web/data/evidence.json"
    }
  ],
  "headers": [
    {
      "source": "/outputs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
